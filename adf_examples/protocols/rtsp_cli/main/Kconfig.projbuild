menu "RTSP CLI Example Configuration"

    config RTSP_EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "SSID"
        help
            SSID (network name) for the example to connect to.

    config RTSP_EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        default "PASSWORD"
        help
            WiFi password (WPA or WPA2) for the example to use.

    config RTSP_EXAMPLE_PUSH_URL
        string "Default push URL"
        default "rtsp://192.168.1.10:8554/live"
        help
            Destination used by 'rtsp push' when no URL argument is given. The
            remote server must accept RTSP ANNOUNCE, SETUP and RECORD.

    config RTSP_EXAMPLE_PULL_URL
        string "Default pull URL"
        default "rtsp://192.168.1.10:8554/live"
        help
            Source used by 'rtsp pull' when no URL argument is given.

endmenu
