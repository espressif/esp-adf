CONFIG_IDF_TARGET="esp32s31"

#
# Flash / PSRAM (esp32_s31_korvo_1)
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Wi-Fi/coex sync objects must stay in internal RAM when XIP from PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=n

#
# Camera: SC101IOT DVP YUV422 YUYV 640x480 @ 15fps (esp32_s31_korvo_1)
#
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=81920
CONFIG_ESP_SCCB_TRANS_TIMEOUT_DEFAULT=2000
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
# 1280x720 is the sensor default; turn it off so only the 640x480 mode is built.
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=n
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_640X480_15FPS=y
CONFIG_CAM_CTRL_SPI_ENABLE=n
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
# The uplink asks for the sensor mode that actually exists on this board.
CONFIG_TONGYI_VISION_CAMERA_WIDTH=640
CONFIG_TONGYI_VISION_CAMERA_HEIGHT=480
CONFIG_TONGYI_VISION_CAMERA_FPS=15
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
