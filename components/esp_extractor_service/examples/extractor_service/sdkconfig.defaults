
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT=n

CONFIG_SPIRAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FatFS / SD
CONFIG_FATFS_LFN_HEAP=y

# Extractor service: enable file, HTTP and HLS by default
CONFIG_ESP_EXTRACTOR_SERVICE_FILE_IO_SUPPORT=y
CONFIG_ESP_EXTRACTOR_SERVICE_HTTP_IO_SUPPORT=y
CONFIG_ESP_EXTRACTOR_SERVICE_HLS_SUPPORT=y

# Dummy sink for link case
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SINK_SUPPORT=y

# Common extractors used by demos
CONFIG_MP4_EXTRACTOR_SUPPORT=y
CONFIG_WAV_EXTRACTOR_SUPPORT=y
CONFIG_AUDIO_ES_EXTRACTOR_SUPPORT=y
CONFIG_TS_EXTRACTOR_SUPPORT=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_MCP_ENABLE=y
CONFIG_ESP_MCP_TRANSPORT_UART=y
CONFIG_ESP_EXTRACTOR_SERVICE_MCP_ENABLE=y
CONFIG_ESP_MEDIA_SERVICE_MCP_ENABLE=y
