CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_UNITY_ENABLE_BACKTRACE_ON_FAIL=y
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SRC_SUPPORT=y
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SINK_SUPPORT=y
CONFIG_ESP_RTSP_SERVICE_SRC_SUPPORT=y
CONFIG_ESP_RTSP_SERVICE_SINK_SUPPORT=y
CONFIG_ESP_RTSP_SERVICE_SERVER_SUPPORT=y

CONFIG_LWIP_MAX_UDP_PCBS=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_UDP_RECVMBOX_SIZE=64