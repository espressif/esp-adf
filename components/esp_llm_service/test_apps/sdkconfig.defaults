CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_UNITY_ENABLE_BACKTRACE_ON_FAIL=y
CONFIG_UNITY_ENABLE_64BIT=y
CONFIG_ESP_MCP_ENABLE=y
CONFIG_ESP_LLM_SERVICE_MCP_ENABLE=y
CONFIG_ESP_LLM_SERVICE_UPLINK_STOP_TIMEOUT_MS=300
CONFIG_ESP_LLM_SERVICE_TEST_HOOKS=y
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SRC_SUPPORT=y
CONFIG_ESP_MEDIA_DUMMY_SERVICE_SINK_SUPPORT=y
