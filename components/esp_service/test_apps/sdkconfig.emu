CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_SVC_TEST_ENABLE_LIFECYCLE_STRESS=n
CONFIG_ESP_SVC_TEST_ENABLE_HTTP_TRANSPORT=n
CONFIG_ESP_SVC_TEST_ENABLE_SSE_TRANSPORT=n
CONFIG_ESP_SVC_TEST_ENABLE_WS_TRANSPORT=n
CONFIG_ESP_SVC_TEST_ENABLE_UART_TRANSPORT=n
CONFIG_ESP_MCP_TRANSPORT_HTTP=n
CONFIG_ESP_MCP_TRANSPORT_SSE=n
CONFIG_ESP_MCP_TRANSPORT_WS=n
CONFIG_ESP_MCP_TRANSPORT_UART=n
CONFIG_ESP_MCP_TRANSPORT_STDIO=n
CONFIG_ESP_MCP_TRANSPORT_SDIO=n
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
